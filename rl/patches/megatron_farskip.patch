+class SimpleFarSkipTransformerLayer(TransformerLayer):
+    """Transformer layer with FarSkip-Collective's far skip connections (no explicit overlap).
+
+    Besides the residual stream ``hidden_states`` (h), the layer takes
+    ``hidden_states_no_routed`` (h'): the previous layer's output without its routed experts'
+    contribution (h' = h for the first layer and after dense layers). With
+    ``r = h + attention(norm(h'))``, it returns ``r + mlp(norm(h))`` and, for the next layer,
+    ``r + shared_experts(norm(h))``. Neither branch then waits for the previous layer's
+    routed-expert all-to-all. ``attn_only_farskip`` feeds the MLP norm(r) instead of norm(h);
+    ``mlp_only_farskip`` feeds attention norm(h) instead of norm(h').
+
+    Returns ``(output, context, hidden_states_no_routed)``; TransformerBlock threads the last
+    element into the next layer. Supports decoder-only stacks without per-layer recompute,
+    offloading, or fused inference kernels.
+    """
+
+    def forward(self, *args, **kwargs):
+        kwargs.pop("dynamic_inference_decode_only", None)
+        kwargs.pop("_called_from_hybrid_mhc_wrapper", None)
+        hidden_states = kwargs.pop("hidden_states") if "hidden_states" in kwargs else args[0]
+        hidden_states_no_routed = kwargs.pop("hidden_states_no_routed", None)
+        if hidden_states_no_routed is None or self.config.mlp_only_farskip:
+            hidden_states_no_routed = hidden_states
+        assert not (
+            self.recompute_input_layernorm or self.recompute_pre_mlp_layernorm or self.recompute_mlp
+        ), "SimpleFarSkipTransformerLayer does not support selective recompute of its modules"
+        assert isinstance(
+            self.cross_attention, (IdentityOp, IdentityFuncOp)
+        ), "SimpleFarSkipTransformerLayer is decoder-only"
+
+        residual = hidden_states.float() if self.config.fp32_residual_connection else hidden_states
+
+        # Attention reads the stream without routed experts; its output joins the full stream.
+        attention_input = apply_module(self.input_layernorm)(hidden_states_no_routed)
+        if isinstance(attention_input, tuple):
+            attention_input = attention_input[0]
+        nvtx_range_push(suffix="self_attention")
+        attention_output, attention_bias = self.self_attention(
+            attention_input,
+            attention_mask=kwargs.get("attention_mask"),
+            inference_context=kwargs.get("inference_context"),
+            rotary_pos_emb=kwargs.get("rotary_pos_emb"),
+            rotary_pos_cos=kwargs.get("rotary_pos_cos"),
+            rotary_pos_sin=kwargs.get("rotary_pos_sin"),
+            rotary_pos_cos_sin=kwargs.get("rotary_pos_cos_sin"),
+            attention_bias=kwargs.get("attention_bias"),
+            packed_seq_params=kwargs.get("packed_seq_params"),
+            sequence_len_offset=kwargs.get("sequence_len_offset"),
+        )
+        nvtx_range_pop(suffix="self_attention")
+        attention_output = self.post_self_attn_layernorm(attention_output)
+        with self.bias_dropout_add_exec_handler():
+            residual_with_attention = self.self_attn_bda(
+                self.training, self.config.bias_dropout_fusion
+            )((attention_output, attention_bias), residual, self.hidden_dropout)
+
+        # The MLP reads the layer input (h), not the post-attention stream.
+        mlp_input = residual_with_attention if self.config.attn_only_farskip else hidden_states
+        mlp_input = apply_module(self.pre_mlp_layernorm)(mlp_input)
+        if isinstance(mlp_input, tuple):
+            mlp_input = mlp_input[0]
+        nvtx_range_push(suffix="mlp")
+        if self.is_moe_layer:
+            mlp_kwargs = {"padding_mask": kwargs.get("padding_mask")}
+            if kwargs.get("input_ids") is not None:
+                mlp_kwargs["input_ids"] = kwargs["input_ids"]
+            if kwargs.get("packed_seq_params") is not None:
+                mlp_kwargs["packed_seq_params"] = kwargs["packed_seq_params"]
+            mlp_output, mlp_bias, shared_expert_output = self.mlp(
+                mlp_input, return_shared_expert_output=True, **mlp_kwargs
+            )
+        else:
+            mlp_output, mlp_bias = apply_module(self.mlp)(mlp_input)
+            shared_expert_output = None
+        nvtx_range_pop(suffix="mlp")
+        mlp_output = self.post_mlp_layernorm(mlp_output)
+
+        with self.bias_dropout_add_exec_handler():
+            bda = self.mlp_bda(self.training, self.config.bias_dropout_fusion)
+            output = bda((mlp_output, mlp_bias), residual_with_attention, self.hidden_dropout)
+            if not self.is_moe_layer:
+                output_no_routed = output
+            elif shared_expert_output is None:
+                output_no_routed = residual_with_attention
+            else:
+                output_no_routed = bda(
+                    (shared_expert_output, None), residual_with_attention, self.hidden_dropout
+                )
+
+        output = make_viewless_tensor(
+            inp=output, requires_grad=output.requires_grad, keep_graph=True
+        )
+        output_no_routed = make_viewless_tensor(
+            inp=output_no_routed, requires_grad=output_no_routed.requires_grad, keep_graph=True
+        )
+        return output, kwargs.get("context"), output_no_routed
